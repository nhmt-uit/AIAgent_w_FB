# Copy to .env and fill in real values. Never commit .env (see .gitignore).

# ANTHROPIC_API_KEY: used by human_bot/content_strategist.py to draft
# genuinely different wording per group when a job post is broadcast to
# several Facebook groups at once (human_bot/data_sync.py). Optional — if
# left blank, that drafting silently falls back to a plain rotating-opener
# template (today's behavior, unchanged). Requires restarting the service
# after setting it (env vars are only read at process startup).
ANTHROPIC_API_KEY=
# Optional override of which Anthropic model content_strategist.py calls —
# leave blank to use its built-in default.
CONTENT_STRATEGIST_MODEL=

# Reserved / not used by the normal pipeline (which is plain Playwright, no
# LLM — see docs/architecture.md). Only needed if human_bot/llm.py's
# vision-fallback path (docs/skills/vision-fallback.md) is ever wired up.
# Get a browser-use key at: https://cloud.browser-use.com/new-api-key
BROWSER_USE_API_KEY=
OPENAI_API_KEY=

# --- Side-B data sync poller (human_bot/data_sync.py) ---
# Pulls new jobs/candidates from the data-ingestion service, dedupes, and
# schedules posts/replies — see docs/architecture.md section 3c.
DATA_INGESTION_BASE_URL=http://localhost:3100
DATA_INGESTION_API_TOKEN=

# All optional — sensible defaults apply if omitted, and all except
# base_url/token are also editable live from /admin (Đồng bộ dữ liệu bên B).
# DATA_SYNC_ENABLED=true
# DATA_SYNC_POLL_INTERVAL_MINUTES=15
# DATA_SYNC_DUE_CHECK_INTERVAL_SECONDS=60
# DATA_SYNC_POST_GAP_MIN_MINUTES=20
# DATA_SYNC_POST_GAP_MAX_MINUTES=90
# DATA_SYNC_COMMENT_GAP_MIN_MINUTES=10
# DATA_SYNC_COMMENT_GAP_MAX_MINUTES=45
# DATA_SYNC_QUIET_HOUR_START=1
# DATA_SYNC_QUIET_HOUR_END=6
# DATA_SYNC_CANDIDATE_MIN_CONFIDENCE=0.8
# DATA_SYNC_CANDIDATE_MAX_AGE_DAYS=14
# DATA_SYNC_CACHE_RETENTION_DAYS=45

# --- Scheduling fire gate (human_bot/scheduling_config.py) --- moved 2026-09-07
# Master safety switch for actually posting a DUE scheduled task to
# Facebook — applies to EVERY scheduled task (auto-sourced from side B, or
# composed by hand at /admin/post), not just the data-sync poller above,
# which is why it's its own setting instead of a DATA_SYNC_* one. Also
# editable live from /admin/config → "Lên lịch & tự động đăng", where its
# current on/off state is now shown directly on /admin/post and
# /admin/schedule too. Old DATA_SYNC_AUTO_FIRE_ENABLED name still works as
# a fallback if this is left unset.
# SCHEDULING_AUTO_FIRE_ENABLED=false

# --- Scheduled-task file cleanup (human_bot/schedule_store.py) --- added 2026-09-05
# How many days to keep old posted/failed/cancelled scheduled-task files
# on disk before permanently deleting them (runs once a day). Reporting
# history is unaffected — it lives in human_bot.db regardless. Pending
# (not-yet-fired) tasks are never touched by this, no matter how old.
# SCHEDULE_RETENTION_DAYS=30

# --- Evidence screenshot cleanup (human_bot/screenshots.py) --- added 2026-09-07
# Every posting attempt (success or failure) saves a screenshot under
# screenshots/<account_id>/, viewable from /admin/reports. How many days to
# keep them before permanently deleting (runs once a day). The text history
# in human_bot.db is unaffected — a pruned screenshot just means that
# report row no longer has an image link.
# SCREENSHOT_RETENTION_DAYS=30

# --- Meme/media auto-attach (human_bot/media.py) --- added 2026-09-04
# Whether post_to_own_profile/post_to_group auto-attach a random image from
# media/memes/ when the caller didn't supply its own media_path. Also
# editable live from /admin/config ("Ảnh đính kèm"). Default: on.
# ATTACH_RANDOM_MEME_DEFAULT=true

# --- Admin UI (human_bot/admin.py, served at /admin) ---
# Strongly recommended if the service's host/port is reachable from
# anywhere but your own machine — /admin can post to Facebook for real.
# Leave both blank only when running purely on localhost for yourself.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- POST /tasks API auth (human_bot/service.py) --- added 2026-09-04
# Same "strongly recommended once reachable beyond your own machine" rule
# as ADMIN_USERNAME/ADMIN_PASSWORD above — this endpoint can post to
# Facebook for real. Leave blank only on localhost for yourself. Once set,
# every POST /tasks call (from n8n, a data-fetching service, etc.) must
# send the same value back in an "X-API-Key" header.
TASKS_API_KEY=

# --- Fallback auto-login only (human_bot/fallback_auto_login.py) ---
# Not used by the normal pipeline. One pair per Facebook account, using the
# same account_id you register in human_bot/config.py. Example:
# FB_EMAIL__my_page=you@example.com
# FB_PASSWORD__my_page=your-password

# --- Human-like typing & pacing (human_bot/humanize.py) ---
# All optional — sensible defaults apply if omitted. See
# docs/skills/human-like-interaction.md for what each one means.
# HUMAN_TYPING_ENABLED=true
# HUMAN_TYPING_WPM=40
# HUMAN_TYPING_STDEV_RATIO=0.35
# HUMAN_TYPING_MIN_DELAY_MS=25
# HUMAN_TYPING_WORD_PAUSE_MIN_MS=150
# HUMAN_TYPING_WORD_PAUSE_MAX_MS=450
# HUMAN_TYPING_PUNCT_PAUSE_MIN_MS=250
# HUMAN_TYPING_PUNCT_PAUSE_MAX_MS=700
# HUMAN_TYPING_TYPO_PROB=0.03
# HUMAN_TYPING_TYPO_NOTICE_MIN_MS=150
# HUMAN_TYPING_TYPO_NOTICE_MAX_MS=450
# HUMAN_TYPING_WORD_TYPO_PROB=0.04
# HUMAN_TYPING_FATIGUE_PER_CHAR=0.0005

# --- Contextual pacing (human_bot/humanize.py's HumanPacingConfig) ---
# Named pauses for specific points in a UI flow — see
# docs/research/human-behavior-simulation.md for the reasoning behind
# these ranges.
# HUMAN_PACE_ENABLED=true
# HUMAN_PACE_PAGE_LOAD_MIN_MS=7000
# HUMAN_PACE_PAGE_LOAD_MAX_MS=10000
# HUMAN_PACE_COMPOSER_OPEN_MIN_MS=3000
# HUMAN_PACE_COMPOSER_OPEN_MAX_MS=5000
# HUMAN_PACE_UI_STEP_MIN_MS=1500
# HUMAN_PACE_UI_STEP_MAX_MS=3000
# HUMAN_PACE_READING_WPM=220
# HUMAN_PACE_READING_MIN_MS=5000
# HUMAN_PACE_READING_MAX_MS=20000
# HUMAN_PACE_READING_BUFFER_MIN_MS=500
# HUMAN_PACE_READING_BUFFER_MAX_MS=2000

# --- Mouse movement (human_bot/humanize.py's HumanMouseConfig) ---
# Bezier-curve-style mouse movement before a click, instead of jumping
# straight there — see docs/research/human-behavior-simulation.md
# (ghost-cursor algorithm summary).
# HUMAN_MOUSE_ENABLED=true
# HUMAN_MOUSE_MIN_STEPS=8
# HUMAN_MOUSE_MAX_STEPS=20
# HUMAN_MOUSE_STEP_DELAY_MIN_MS=8
# HUMAN_MOUSE_STEP_DELAY_MAX_MS=20
# HUMAN_MOUSE_CURVE_OFFSET_RATIO=0.18
# HUMAN_MOUSE_OVERSHOOT_PROB=0.15
# HUMAN_MOUSE_OVERSHOOT_RATIO=0.08
# HUMAN_MOUSE_MIN_DISTANCE_PX=12
