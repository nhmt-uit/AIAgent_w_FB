# Copy to .env and fill in real values. Never commit .env (see .gitignore).

# Reserved / not used by the normal pipeline (which is plain Playwright, no
# LLM — see docs/architecture.md). Only needed if human_bot/llm.py's
# vision-fallback path (docs/skills/vision-fallback.md) is ever wired up.
# Get a browser-use key at: https://cloud.browser-use.com/new-api-key
BROWSER_USE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Admin UI (human_bot/admin.py, served at /admin) ---
# Strongly recommended if the service's host/port is reachable from
# anywhere but your own machine — /admin can post to Facebook for real.
# Leave both blank only when running purely on localhost for yourself.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Fallback auto-login only (human_bot/fallback_auto_login.py) ---
# Not used by the normal pipeline. One pair per Facebook account, using the
# same account_id you register in human_bot/config.py. Example:
# FB_EMAIL__my_page=you@example.com
# FB_PASSWORD__my_page=your-password

# --- Human-like typing & pacing (human_bot/humanize.py) ---
# All optional — sensible defaults apply if omitted. See
# docs/skills/human-like-interaction.md for what each one means.
# HUMAN_TYPING_ENABLED=true
# HUMAN_TYPING_WPM=40
# HUMAN_TYPING_STDEV_RATIO=0.35
# HUMAN_TYPING_MIN_DELAY_MS=25
# HUMAN_TYPING_WORD_PAUSE_MIN_MS=150
# HUMAN_TYPING_WORD_PAUSE_MAX_MS=450
# HUMAN_TYPING_PUNCT_PAUSE_MIN_MS=250
# HUMAN_TYPING_PUNCT_PAUSE_MAX_MS=700
# HUMAN_TYPING_TYPO_PROB=0.03
# HUMAN_TYPING_TYPO_NOTICE_MIN_MS=150
# HUMAN_TYPING_TYPO_NOTICE_MAX_MS=450
# HUMAN_TYPING_FATIGUE_PER_CHAR=0.0005
